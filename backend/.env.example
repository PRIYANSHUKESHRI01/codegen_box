APP_NAME="AptRun"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
FRONTEND_URL=http://localhost:3000
# Browsers may call this API only from FRONTEND_URL (and the local dev origins when APP_ENV is not production).
# Extra origins, comma-separated, e.g. a www/non-www twin or a staging site:
# CORS_ALLOWED_ORIGINS=https://www.example.com,https://staging.example.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=aptrun
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
# Production example (Gmail / Google Workspace — needs an App Password, not the account password):
#   MAIL_MAILER=smtp  MAIL_HOST=smtp.gmail.com  MAIL_PORT=465  MAIL_SCHEME=smtps
#   MAIL_USERNAME=support@your-domain  MAIL_PASSWORD=<16-char app password>  MAIL_FROM_ADDRESS=support@your-domain
# MAIL_MAILER=log / array "send" nothing. Check the real thing with:  php artisan mail:check
# Links in e-mails (unsubscribe) are built from APP_URL; buttons from FRONTEND_URL. Both must be the PUBLIC addresses.

# Reminders and nudges (plan ending, "close to the Vault", upgrade, win-back) — see config/lifecycle_mail.php and
# docs/email-notifications.md. Needs the every-minute `schedule:run` cron.
# LIFECYCLE_ENGAGEMENT_ENABLED=true     false = pause the nudges (plan-ending reminders still go)
# LIFECYCLE_MAX_PER_RUN=300             most nudges one daily run may send (mailbox daily limit: Gmail 500, Workspace 2000)
# LIFECYCLE_RUN_AT=11:00                daily run time, in LIFECYCLE_TIMEZONE (default Asia/Kolkata)
# QUEUE_DRAIN_FROM_SCHEDULER=true       scheduler also works off the default queue each minute (no queue worker needed)

# WHATSAPP_PROVIDER=log writes outgoing WhatsApp messages to the app log
# instead of sending them — no real WhatsApp Business account needed for
# local dev. Set to "meta" + the two values below once you have a real
# Meta Cloud API app (phone number id + a permanent access token).
WHATSAPP_PROVIDER=log
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=

# ---------------------------------------------------------------------------
# Firebase Phone (OTP) verification — Settings > Profile "Verify Phone Number".
# The SMS/OTP round-trip happens entirely client-side (Firebase JS SDK talks
# directly to Google, not through this backend at all — see
# frontend/src/lib/firebase.ts), so this app never needs SMS-sending
# credentials. The backend's only job is verifying the resulting ID token
# (App\Services\FirebasePhoneVerificationService) via Google's public keys,
# which only needs FIREBASE_PROJECT_ID (issuer/audience check) — the rest are
# the CLIENT SDK's config values and must ALSO be copied into
# frontend/.env.local as NEXT_PUBLIC_FIREBASE_* (see that file), since the
# frontend is a separate Next.js app, not server-rendered by Laravel.
# Leave FIREBASE_PROJECT_ID blank for local dev — phone verification then
# honestly reports "not configured" (never a 500).
# ---------------------------------------------------------------------------
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_MEASUREMENT_ID=

# AI Interview question generation (see App\Services\GeminiQuestionGeneratorService).
# Leave GEMINI_API_KEY blank for local dev — the generate endpoint honestly
# reports "not configured" and every creation flow falls back to picking
# from the existing bank. Get a key from https://aistudio.google.com/apikey.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
# Speaking Practice sends each recording to Gemini twice, in parallel: once to score it, once for the
# informational "worth a second listen" pronunciation hints. Set to false to halve the request count if
# you are on a tight quota. IMPORTANT for production: use a PAID Gemini API tier. The free tier is capped
# at 15 requests/minute for the whole project and Google may use free-tier content to improve its products,
# which must not apply to students' voice recordings. See docs/speaking-practice.md.
GEMINI_SPEAKING_PRONUNCIATION_NOTES=true

# The interviewer's voice (config/interview_speech.php, docs/ai-interview-room.md). Questions are read aloud by a neural voice,
# synthesised once and cached. INTERVIEW_SPEECH_DRIVER=auto uses the best provider that has a key (elevenlabs > openai > gemini);
# with no key at all the browser's own voice is used. The Gemini key above already works - Gemini TTS needs nothing else.
# For the most natural voice, set ELEVENLABS_API_KEY. Hear the options: php artisan interview:speech-sample
# After changing voice or provider: php artisan interview:warm-speech
INTERVIEW_SPEECH_ENABLED=true
INTERVIEW_SPEECH_DRIVER=auto
GEMINI_TTS_VOICE=Sulafat
GEMINI_TTS_MODEL=gemini-3.8-flash-tts
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL
ELEVENLABS_TTS_MODEL=eleven_multilingual_v2
OPENAI_API_KEY=
OPENAI_TTS_VOICE=marin

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# Code execution (Piston) + judge queue.  Full guide: docs/scaling-the-judge.md
# ---------------------------------------------------------------------------
# Execution nodes: comma-separated, each optionally `|<slots>` (that node's
# PISTON_MAX_CONCURRENT_JOBS), which must be the node's PHYSICAL core count (more slots than
# cores inflates CPU times and gets correct solutions killed — measured, see the guide).
# One node locally, several in production (here 3 nodes of 16 physical cores = 48 slots):
#   PISTON_NODES=http://judge-1:2000|16,http://judge-2:2000|16,http://judge-3:2000|16
PISTON_NODES=http://localhost:2000|8
# (PISTON_BASE_URL, a single node, is still honoured if PISTON_NODES is unset.)
#
# Local dev: one node from infra/judge/docker-compose.yml (or a bare
#   docker run --privileged -p 2000:2000 ghcr.io/engineer-man/piston
# then ./infra/judge/install-runtimes.sh). NOTE the bare `docker run` defaults
# kill any program that prints over 1 KB and cap CPU at 3s (breaks Java) —
# use the compose file, which sets PISTON_OUTPUT_MAX_SIZE / PISTON_RUN_CPU_TIME.
#
# Judge queue: APP_ENV=local judges inline (sync) so no worker is needed.
# Staging/production MUST use a real queue + workers:
#   QUEUE_CONNECTION=redis   CACHE_STORE=redis   REDIS_CLIENT=phpredis   (predis is installed and works too)
# Two Redis instances (infra/redis): the queue on `noeviction`, the cache on `allkeys-lru`:
#   REDIS_HOST=... REDIS_PORT=6379 REDIS_PASSWORD=...
#   REDIS_CACHE_HOST=... REDIS_CACHE_PORT=6380     (cache password/host fall back to REDIS_*)
#   php artisan queue:work redis --queue=judge-contest,judge-submit,judge-run
# (supervisor config: infra/judge/supervisor/judge-workers.conf)
# JUDGE_QUEUE_CONNECTION=sync
#
# Limits (defaults shown): per-USER, never per-IP — a campus lab shares one IP.
# JUDGE_MAX_CODE_LENGTH=65536
# JUDGE_MAX_ACTIVE_PER_USER=3
# JUDGE_RATE_RUN_PER_MINUTE=20
# JUDGE_RATE_SUBMIT_PER_MINUTE=10
# JUDGE_MAX_DEPTH_SUBMIT=5000        # queue depth past which new work gets 503 + Retry-After.
#   SET THIS FROM YOUR CAPACITY: about (verdicts per second the fleet sustains) x 120 — the browser
#   gives up after 120s. 5000 assumes a fleet doing ~40/s; a 4-core laptop does ~1.3/s => ~160.
# JUDGE_RESULT_TTL=900               # how long a verdict stays pollable; must exceed the longest queue wait
# JUDGE_JOB_RETRY_FOR=240            # seconds to retry an outage, counted from the job's first execution
# PISTON_RUN_TIMEOUT_MS=7000         # wall clock per run (how long a sleeping/blocked program holds a slot)
# PISTON_JAVA_RUN_CPU_TIME_MS=8000   # the JVM burns 2-3 CPU-seconds just starting

# ---------------------------------------------------------------------------
# Daily auto-generated contest (App\Console\Commands\GenerateDailyContest)
# ---------------------------------------------------------------------------
# DAILY_CONTEST_TIMEZONE=Asia/Kolkata
# DAILY_CONTEST_START_TIME=19:00
# DAILY_CONTEST_DURATION_MINUTES=60
# DAILY_CONTEST_CANDIDATE_POOL_SIZE=10

# ---------------------------------------------------------------------------
# Contest proctoring (App\Services\ProctoringService) — contest problems only,
# never practice. Webcam VIDEO stays in the browser; only small stills go to
# the server (see the Exam integrity block below and docs/exam-integrity.md).
# A student is locked out (current code auto-submitted,
# then blocked from run/submit/show for the rest of the contest) once their
# violation_count reaches PROCTORING_MAX_VIOLATIONS.
# ---------------------------------------------------------------------------
# PROCTORING_MAX_VIOLATIONS=3
# PROCTORING_AUTO_SUBMIT_ON_LOCK=true

# ---------------------------------------------------------------------------
# Exam integrity (App\Services\Integrity, config/integrity.php, docs/exam-integrity.md) — the layer under EVERY
# proctored surface: signed heartbeat, tamper-evident log, evidence stills, device/address binding, the Guardian.
# Needs: php artisan migrate · php artisan route:cache · PHP "sodium" extension · the scheduler cron.
# ---------------------------------------------------------------------------
# INTEGRITY_ENABLED=true            # false = everything behaves exactly as before this layer existed
# INTEGRITY_ENFORCE=true            # false = "observe mode": record and show reviewers, refuse nothing (use for the first roll-out)
#
# Which profile each surface runs under (strict | standard | practice):
# INTEGRITY_PROFILE_CONTEST=strict
# INTEGRITY_PROFILE_CORE_TEST=strict
# INTEGRITY_PROFILE_SOFT_SKILL=standard
# INTEGRITY_PROFILE_INTERVIEW=standard
# INTEGRITY_PROFILE_STUDY=practice
#
# Per-profile overrides, e.g. require the Guardian / drop the screen share for a campus:
# INTEGRITY_STRICT_GUARDIAN=optional            # required | optional | off
# INTEGRITY_STRICT_SCREEN_SHARE=required        # required | optional | off
# INTEGRITY_STRICT_CHROMIUM_ONLY=true
# INTEGRITY_STRICT_WEBCAM_SNAPSHOT=30           # seconds between webcam stills (0 = none)
# INTEGRITY_STRICT_SCREEN_SNAPSHOT=60
#
# Exam network (CIDR, comma separated). When set, a proctored attempt can only START from inside it. A college can add its own
# (TPO → Proctoring → Exam network).
# INTEGRITY_ALLOWED_RANGES=
# INTEGRITY_BLOCKED_RANGES=
# INTEGRITY_IP_CHANGE=flag                      # flag | strike — what an address change mid-attempt costs
#
# Evidence stills: encrypted (key derived from APP_KEY), private disk, deleted after the retention below.
# INTEGRITY_EVIDENCE_DISK=local
# INTEGRITY_EVIDENCE_RETENTION_DAYS=45
# INTEGRITY_EVIDENCE_FLAGGED_RETENTION_DAYS=365
# INTEGRITY_EVIDENCE_MAX_SESSION_BYTES=157286400
#
# The Windows Guardian (see /guardian): set after build.ps1 prints the hash and you host the zip.
# GUARDIAN_ALLOWED_BUILDS=                      # SHA-256 of released builds, comma separated; empty = accept any (development only)
# GUARDIAN_DOWNLOAD_URL=                       # leave EMPTY: the server then offers the installer in storage/app/guardian itself (GET /api/guardian/download); set only to host it elsewhere
# GUARDIAN_PACKAGE_PATH=                       # default storage/app/guardian/aptrun-guardian.exe (+ aptrun-guardian.json next to it for the version shown)
# GUARDIAN_MIN_VERSION=1.0.0
# GUARDIAN_TLS_PINS=                           # base64 SHA-256 of your CA's SubjectPublicKeyInfo: the Guardian reports HTTPS interception when none is in the chain. Empty = off.

# ---------------------------------------------------------------------------
# Project Lab — browser VS Code workspaces, included with the Grandmaster plan (docs/project-lab.md, docs/pricing-and-plans.md).
# Laravel only CONTROLS workspaces; the containers run on a separate Docker
# host (never the web server). Defaults suit a laptop: Docker Desktop, the
# gateway from infra/workspaces/docker-compose.local.yml on :8081.
#
#   UI work without Docker:   WORKSPACE_RUNTIME=fake   (nothing is served at the editor URL)
#   Local, real:              build the image + start the gateway (see the doc), keep the defaults
#   Production:               WORKSPACE_HOSTS with ssh://deploy@HOST, WORKSPACE_OCI_RUNTIME=runsc,
#                             and the app + workspace domains under ONE registrable domain.
# ---------------------------------------------------------------------------
# WORKSPACES_ENABLED=true                     # kill switch: false => "Open workspace" answers 503
# WORKSPACE_RUNTIME=docker                    # docker | fake
# WORKSPACE_IMAGE=aptrun/workspace:latest
# WORKSPACE_DOMAIN=localhost:8081             # single local host; ignored when WORKSPACE_HOSTS is set
# WORKSPACE_SCHEME=http
# WORKSPACE_HOSTS=[{"name":"ws-1","docker_host":"ssh://deploy@ws-1.example.com","capacity":24,"domain":"ws.example.com","scheme":"https"}]
# WORKSPACE_OCI_RUNTIME=runsc                 # gVisor: strongly recommended in production
# WORKSPACE_MEMORY=2g
# WORKSPACE_CPUS=1.5
# WORKSPACE_DISK_MB=3072
# WORKSPACE_IDLE_MINUTES=15
# WORKSPACE_MAX_SESSION_MINUTES=480
# WORKSPACE_SNAPSHOT_DISK=local               # point at an S3 disk in production (Render's disk is ephemeral)
# BILLING_ADDON_BUNDLE_DISCOUNT_PERCENT=30    # percent off an add-on bought next to a paid plan (none is on sale today); 0 disables it

# ---------------------------------------------------------------------------
# Student plan payments. Two gateways are built in; exactly one takes new checkouts.
#   PAYMENT_GATEWAY=payu        PayU Hosted Checkout  — docs/payments-payu.md      (the default)
#   PAYMENT_GATEWAY=razorpay    Razorpay Standard Checkout — docs/payments-razorpay.md
# Switching is just this line (then `php artisan config:cache`). Orders already opened on the other
# gateway keep working as long as ITS credentials stay below. A typo here switches payments off; a BLANK value means the default (payu).
# ---------------------------------------------------------------------------
PAYMENT_GATEWAY=payu

# ---------------------------------------------------------------------------
# PayU — Hosted Checkout. Full guide: docs/payments-payu.md
# ---------------------------------------------------------------------------
# Leave PAYU_KEY / PAYU_SALT blank and paid checkout answers "payments are not set up yet" (503) —
# a paid plan is never activated without money moving.
#   PAYU_KEY     PayU Dashboard → Payment Gateway → API keys → Merchant Key. Test mode and Live mode have separate ones.
#   PAYU_SALT    Merchant Salt (use Salt v2). SECRET — every hash, request and webhook check depends on it. Never in the frontend.
#   PAYU_MODE    test (PayU's sandbox; the default) or live. PayU keys don't say which they are, so this is explicit.
#                Switch it together with the key and salt, never alone.
#   PAYU_WEBHOOK_TOKEN   Optional but recommended: any long random string. Add it to the webhook URL you give PayU:
#                https://<api-host>/api/webhooks/payu?token=<this value>
#                PayU signs payment events, but sends refund/dispute events UNSIGNED — this keeps strangers from posting them.
#   PAYU_WEBHOOK_ALLOWED_IPS   Optional comma-separated allow-list of PayU's webhook IPs. Only if the app sees real client IPs.
#   PAYU_RETURN_URL   Only if needed: the public address PayU sends the student's browser back to (max 50 characters!).
#                Default: <APP_URL>/api/payu/return. Behind a proxy that hides https from PHP, set it explicitly.
PAYU_KEY=
PAYU_SALT=
PAYU_MODE=test
# PAYU_WEBHOOK_TOKEN=
# PAYU_WEBHOOK_ALLOWED_IPS=
# PAYU_RETURN_URL=https://api.example.com/api/payu/return
# PAYU_CHECKOUT_URL=      # only ever overridden by end-to-end tests (a local fake PayU)
# PAYU_API_URL=           # same

# ---------------------------------------------------------------------------
# Razorpay — the alternative gateway (PAYMENT_GATEWAY=razorpay). Full guide: docs/payments-razorpay.md
# ---------------------------------------------------------------------------
# Leave the key pair blank and paid checkout answers "payments are not set up yet" (503) —
# a paid plan is never activated without money moving.
#   RAZORPAY_KEY_ID       Dashboard → Account & Settings → API Keys. rzp_test_… (Test mode) or rzp_live_… (Live mode).
#   RAZORPAY_KEY_SECRET   Shown once at key generation. Server-side only — never put it in frontend/.env.local.
#   RAZORPAY_WEBHOOK_SECRET  A secret YOU choose when adding the webhook (Dashboard → Webhooks; NOT the key secret).
#                         Webhook URL: https://<api-host>/api/webhooks/razorpay
#                         Events: payment.authorized, payment.captured, payment.failed, order.paid, refund.processed
# Test mode and Live mode have separate keys AND separate webhook configs — switch all three together.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# RAZORPAY_MERCHANT_NAME=AptRun               # the title on the Checkout window
# RAZORPAY_THEME_COLOR=#4F46E5
# RAZORPAY_API_BASE=https://api.razorpay.com/v1   # only ever overridden by the end-to-end tests (a local fake gateway)

# ---------------------------------------------------------------------------
# Vault — students whose readiness score says they are ready to be hired.
# Full guide (scoring, consent, the Mellow Vault wire contract): docs/readiness-and-vault.md
# ---------------------------------------------------------------------------
# A student whose readiness reaches VAULT_ENTER_SCORE becomes eligible; once they have said yes (one click, revocable)
# they are listed to AptRun's hiring partners and handed to Mellow Vault. They come off only when the score drops below
# VAULT_EXIT_SCORE — the gap stops a score hovering around 60 from flapping on and off employers' screens.
#   VAULT_SYNC_URL      Where AptRun POSTs profile.upsert / profile.withdraw events (Mellow Vault's receiving endpoint).
#                       Blank = not connected: nothing is sent and NOTHING IS LOST — events wait and go out once set.
#   VAULT_SYNC_SECRET   Shared secret; every delivery is signed with it (HMAC-SHA256). SECRET. Without it nothing is ever sent.
#   VAULT_API_KEY       Bearer token Mellow Vault presents when it calls AptRun (GET /api/vault/v1/profiles, resume,
#                       "hired" callback). Blank = those routes answer 503. SECRET — use a long random string
#                       (php -r "echo bin2hex(random_bytes(32));"), and a different one from VAULT_SYNC_SECRET.
# Needs the every-minute scheduler cron (`* * * * * php artisan schedule:run`): it runs readiness:refresh and vault:sync.
# No queue worker is needed for the hand-off itself.
VAULT_ENTER_SCORE=60
VAULT_EXIT_SCORE=55
# How a listed student reaches Mellow Vault:
#   http      (production) signed POST to VAULT_SYNC_URL - Mellow Vault runs the receiving endpoint.
#   database  (temporary, local) written straight into Mellow Vault's developer_details_tb through the MELLOW_VAULT_DB_* connection below.
VAULT_SYNC_DRIVER=http
# Only for VAULT_SYNC_DRIVER=database. The XAMPP database that holds Mellow Vault's developer_details_tb.
MELLOW_VAULT_DB_HOST=127.0.0.1
MELLOW_VAULT_DB_PORT=3306
MELLOW_VAULT_DB_DATABASE=
MELLOW_VAULT_DB_USERNAME=root
MELLOW_VAULT_DB_PASSWORD=
# MELLOW_VAULT_DEFAULT_PRO_ID=0                    Mellow Vault's pro_id for a student whose domain is not in the map (0 = unspecified).
# MELLOW_VAULT_PRO_ID_MAP={"laravel_developer":24}   AptRun stack or role key => Mellow Vault pro_id. Ask Mellow Vault for the list.
# MELLOW_VAULT_COLLEGE_VERIFIED=true               File a college student's TPO as the HOD contact and mark them verified.
VAULT_SYNC_URL=
VAULT_SYNC_SECRET=
VAULT_API_KEY=
# VAULT_SYNC_TIMEOUT=10
# VAULT_SYNC_MAX_ATTEMPTS=8
