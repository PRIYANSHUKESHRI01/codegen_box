# Slots per Piston node = that host's PHYSICAL core count (PISTON_MAX_CONCURRENT_JOBS): on most
# x86 cloud instances that is vCPUs / 2. Measured on real Piston: more slots than physical cores
# inflates every job's CPU time (Java 4-6x), wall time stretches, and correct solutions are killed
# by a CPU/wall limit; throughput stops rising at the core count. See docs/scaling-the-judge.md §3.
JUDGE_SLOTS=8
