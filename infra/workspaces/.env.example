# Workspace host gateway (docker-compose.yml). Copy to .env on the HOST.

# The wildcard domain. DNS: an A record  *.ws.example.com  →  this host's public IP.
# It must share a registrable domain with the web app (app.example.com ↔ ws.example.com).
WORKSPACE_DOMAIN=ws.example.com

# Which origins may embed the editor in an iframe (space separated).
APP_ORIGINS=https://app.example.com

# Cloudflare API token with Zone:DNS:Edit on the zone, for the wildcard certificate.
CLOUDFLARE_API_TOKEN=

# Fixed IP of the gateway on the workspace network (must match host-firewall.sh).
GATEWAY_IP=172.30.0.2
